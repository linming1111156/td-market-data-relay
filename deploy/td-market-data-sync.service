[Unit]
Description=Continuously restore verified public market capture files from TD relay
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/data/td-market-data-local

[Service]
Type=simple
User=td-marketdata
Group=td-marketdata
WorkingDirectory=/opt/td-market-data-relay
EnvironmentFile=/etc/td-market-data-relay/sync.env
ExecStart=/opt/td-market-data-relay/.venv/bin/python3 /opt/td-market-data-relay/sync.py --output /mnt/data/td-market-data-local/hot --archive-root /mnt/data/td-market-data-local/archive --continuous --poll-seconds 300 --state-file /mnt/data/td-market-data-local/state/vps-sync-cursor.json
Restart=always
RestartSec=30s
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/mnt/data/td-market-data-local
MemoryMax=256M

[Install]
WantedBy=multi-user.target
